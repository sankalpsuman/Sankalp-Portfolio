{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*).(png|jpg|jpeg|gif|svg|webp|avif|ico)", "dest": "/$1.$2", "headers": { "Cache-Control": "public, max-age=86400, must-revalidate" } },
    { "src": "/(.*).(woff|woff2|ttf|otf)", "dest": "/$1.$2", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
