{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**,firebase-applet-config.json,api/_server.js,api/_server.js.map",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
