{
  "entities": {
    "hero": {
      "title": "Hero Section",
      "description": "Content for the hero section of the portfolio.",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "titles": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "githubUrl": { "type": "string" }
      },
      "required": ["headline", "titles", "description"]
    },
    "about": {
      "title": "About Section",
      "description": "Content for the about section.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "imageUrl": { "type": "string" }
      }
    },
    "experience": {
      "title": "Experience",
      "description": "Work experience entries.",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "role": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "skill": {
      "title": "Skill",
      "description": "Skills categorized by type.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "number" },
        "icon": { "type": "string" },
        "proficiency": { "type": "string" },
        "experienceYears": { "type": "number" },
        "featured": { "type": "boolean" },
        "badge": { "type": "string" },
        "learningStatus": { "type": "string" }
      }
    },
    "project": {
      "title": "Project",
      "description": "Portfolio projects and case studies.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "liveUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "order": { "type": "number" },
        "challenge": { "type": "string" },
        "goal": { "type": "string" },
        "solution": { "type": "string" },
        "testingStrategy": { "type": "string" },
        "architecture": { "type": "string" },
        "toolsUsed": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "businessImpact": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "lessonsLearned": { "type": "string" }
      }
    },
    "certification": {
      "title": "Certification",
      "description": "Professional certifications.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "post": {
      "title": "Post",
      "description": "Thought leadership / LinkedIn posts.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "url": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "contact": {
      "title": "Contact",
      "description": "Contact information.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" }
      }
    },
    "seo": {
      "title": "SEO",
      "description": "SEO metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "ogImage": { "type": "string" }
      }
    },
    "ai": {
      "title": "AI in QA",
      "description": "Content for the AI in QA section.",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "subheadline": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "desc": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        },
        "efficiency": { "type": "string" },
        "reliability": { "type": "string" }
      },
      "required": ["headline", "subheadline", "steps", "efficiency", "reliability"]
    },
    "message": {
      "title": "Inquiry Message",
      "description": "Inbound messages from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "blog": {
      "title": "Blog Post",
      "description": "Article with rich text/markdown content.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string" },
        "publishedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" }
      },
      "required": ["title", "slug", "content"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Client or colleague feedback.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "content": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "rating": { "type": "number" },
        "order": { "type": "number" }
      }
    },
    "milestone": {
      "title": "Journey Milestone",
      "description": "Key event in career timeline.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "logoUrl": { "type": "string" },
        "color": { "type": "string" },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" }
      }
    },
    "metric": {
      "title": "QA Metric",
      "description": "Quality assurance data point for dashboard.",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "trend": { "type": "string" },
        "type": { "type": "string", "enum": ["counter", "percentage", "health"] },
        "order": { "type": "number" }
      }
    },
    "impactStory": {
      "title": "Impact Story",
      "description": "Business impact case study.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "problem": { "type": "string" },
        "solution": { "type": "string" },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "settings": {
      "title": "Global Settings",
      "description": "Centralized site configuration.",
      "type": "object",
      "properties": {
        "themeColor": { "type": "string" },
        "enableBlog": { "type": "boolean" },
        "enableAI": { "type": "boolean" },
        "enableTimeline": { "type": "boolean" },
        "calendlyUrl": { "type": "string" },
        "resumeLink": { "type": "string" }
      }
    },
    "aiTool": {
      "title": "AI Tool",
      "description": "Definition for AI QA Playground tool.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "prompt": { "type": "string" },
        "icon": { "type": "string" },
        "placeholder": { "type": "string" },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      }
    },
    "now": {
      "title": "Now Page",
      "description": "Content for the /now page.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "lastUpdated": { "type": "string" }
      }
    },
    "chat_session": {
      "title": "Chat Session",
      "description": "Interactive AI Assistant chat conversations with visitors.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model", "system"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "isRecruiterLead": { "type": "boolean" },
        "leadData": {
          "type": "object",
          "properties": {
            "recruiterName": { "type": "string" },
            "companyName": { "type": "string" },
            "email": { "type": "string" },
            "roleDetails": { "type": "string" },
            "location": { "type": "string" }
          }
        },
        "notified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sessionId", "messages", "createdAt"]
    },
    "resume": {
      "title": "Resume",
      "description": "Resume metadata and files.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "previewUrl": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "downloadsCount": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["title", "category", "version"]
    },
    "achievement": {
      "title": "Achievement & Award",
      "description": "Professional achievements and awards.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "badge": { "type": "string" },
        "imageUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["title", "organization", "date"]
    },
    "whyHireMe": {
      "title": "Why Hire Me",
      "description": "Recruiter focus selling points and stats.",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "description": { "type": "string" },
        "statistics": { 
          "type": "array", 
          "items": { 
            "type": "object", 
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "ctaText": { "type": "string" },
        "ctaUrl": { "type": "string" }
      },
      "required": ["headline", "description"]
    },
    "availability": {
      "title": "Availability Status",
      "description": "Job search availability status values.",
      "type": "object",
      "properties": {
        "openToWork": { "type": "boolean" },
        "openToRemote": { "type": "boolean" },
        "openToGermany": { "type": "boolean" },
        "openToUSA": { "type": "boolean" },
        "openToContract": { "type": "boolean" },
        "openToFreelance": { "type": "boolean" },
        "note": { "type": "string" },
        "lastUpdated": { "type": "string" }
      }
    },
    "faq": {
      "title": "Frequently Asked Question",
      "description": "Standard FAQ for recruiters and visitors.",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" },
        "visible": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["question", "answer", "category"]
    },
    "bookMeeting": {
      "title": "Book Meeting Settings",
      "description": "Configuration for the Calendly and scheduling widget.",
      "type": "object",
      "properties": {
        "calendlyUrl": { "type": "string" },
        "googleCalendarUrl": { "type": "string" },
        "ctaTitle": { "type": "string" },
        "ctaDescription": { "type": "string" }
      },
      "required": ["calendlyUrl", "ctaTitle", "ctaDescription"]
    },
    "translation": {
      "title": "Translation Cache",
      "description": "Cached translations for dynamic content to avoid duplicate AI requests.",
      "type": "object",
      "properties": {
        "originalText": { "type": "string" },
        "language": { "type": "string" },
        "translatedText": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["originalText", "language", "translatedText", "createdAt"]
    }
  },
