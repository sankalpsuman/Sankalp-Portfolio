{
  "entities": {
    "hero": {
      "title": "Hero Section",
      "description": "Content for the hero section of the portfolio.",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "titles": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "githubUrl": { "type": "string" }
      },
      "required": ["headline", "titles", "description"]
    },
    "about": {
      "title": "About Section",
      "description": "Content for the about section.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "imageUrl": { "type": "string" }
      }
    },
    "experience": {
      "title": "Experience",
      "description": "Work experience entries.",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "role": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "skill": {
      "title": "Skill",
      "description": "Skills categorized by type.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "number" },
        "icon": { "type": "string" }
      }
    },
    "project": {
      "title": "Project",
      "description": "Portfolio projects.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "liveUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "certification": {
      "title": "Certification",
      "description": "Professional certifications.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "post": {
      "title": "Post",
      "description": "Thought leadership / LinkedIn posts.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "url": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "contact": {
      "title": "Contact",
      "description": "Contact information.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" }
      }
    },
    "seo": {
      "title": "SEO",
      "description": "SEO metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "ogImage": { "type": "string" }
      }
    },
    "ai": {
      "title": "AI in QA",
      "description": "Content for the AI in QA section.",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "subheadline": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "desc": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        },
        "efficiency": { "type": "string" },
        "reliability": { "type": "string" }
      },
      "required": ["headline", "subheadline", "steps", "efficiency", "reliability"]
    },
    "message": {
      "title": "Inquiry Message",
      "description": "Inbound messages from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "blog": {
      "title": "Blog Post",
      "description": "Article with rich text/markdown content.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string" },
        "publishedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" }
      },
      "required": ["title", "slug", "content"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Client or colleague feedback.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "content": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "rating": { "type": "number" },
        "order": { "type": "number" }
      }
    },
    "milestone": {
      "title": "Journey Milestone",
      "description": "Key event in career timeline.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "logoUrl": { "type": "string" },
        "color": { "type": "string" },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" }
      }
    },
    "metric": {
      "title": "QA Metric",
      "description": "Quality assurance data point for dashboard.",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "trend": { "type": "string" },
        "type": { "type": "string", "enum": ["counter", "percentage", "health"] },
        "order": { "type": "number" }
      }
    },
    "impactStory": {
      "title": "Impact Story",
      "description": "Business impact case study.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "problem": { "type": "string" },
        "solution": { "type": "string" },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "settings": {
      "title": "Global Settings",
      "description": "Centralized site configuration.",
      "type": "object",
      "properties": {
        "themeColor": { "type": "string" },
        "enableBlog": { "type": "boolean" },
        "enableAI": { "type": "boolean" },
        "enableTimeline": { "type": "boolean" },
        "calendlyUrl": { "type": "string" },
        "resumeLink": { "type": "string" }
      }
    },
    "aiTool": {
      "title": "AI Tool",
      "description": "Definition for AI QA Playground tool.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "prompt": { "type": "string" },
        "icon": { "type": "string" },
        "placeholder": { "type": "string" },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      }
    },
    "now": {
      "title": "Now Page",
      "description": "Content for the /now page.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "lastUpdated": { "type": "string" }
      }
    }
  },
  "firestore": {
    "hero/content": {
      "schema": "hero",
      "description": "Singleton for hero content."
    },
    "about/content": {
      "schema": "about",
      "description": "Singleton for about content."
    },
    "experience": {
      "schema": "experience",
      "description": "Collection of experiences."
    },
    "skills": {
      "schema": "skill",
      "description": "Collection of skills."
    },
    "projects": {
      "schema": "project",
      "description": "Collection of projects."
    },
    "certifications": {
      "schema": "certification",
      "description": "Collection of certifications."
    },
    "posts": {
      "schema": "post",
      "description": "Collection of thought leadership posts."
    },
    "contact/info": {
      "schema": "contact",
      "description": "Singleton for contact info."
    },
    "seo/config": {
      "schema": "seo",
      "description": "Singleton for SEO config."
    },
    "ai/content": {
      "schema": "ai",
      "description": "Singleton for AI in QA content."
    },
    "messages": {
      "schema": "message",
      "description": "Collection of contact inquiries."
    },
    "blogs": {
      "schema": "blog",
      "description": "Collection of blog articles."
    },
    "testimonials": {
      "schema": "testimonial",
      "description": "Collection of testimonials."
    },
    "timeline": {
      "schema": "milestone",
      "description": "Collection of career milestones."
    },
    "qaMetrics": {
      "schema": "metric",
      "description": "Collection of QA dashboard metrics."
    },
    "impactStories": {
      "schema": "impactStory",
      "description": "Collection of impact stories."
    },
    "settings/global": {
      "schema": "settings",
      "description": "Singleton for global settings."
    },
    "aiTools": {
      "schema": "aiTool",
      "description": "Collection of AI playground tools."
    },
    "now/content": {
      "schema": "now",
      "description": "Singleton for now page content."
    }
  }
}
